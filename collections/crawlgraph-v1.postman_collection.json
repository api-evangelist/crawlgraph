          "name": "Look up referring domains for a target domain",
          "request": {
            "name": "Look up referring domains for a target domain",
            "description": {
              "content": "Public-API backlink lookup.\n\nValidates ``domain`` and ``release_id`` (400 ``validation_error`` on\nfailure), charges one call against the caller's monthly\n``backlinks`` quota (429 ``quota_exceeded`` on overflow), then runs\nthe same DuckDB query the internal route uses and returns the\nsliced results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "backlinks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"<string>\",\n  \"release_id\": \"<string>\",\n  \"limit\": 1000,\n  \"sort\": \"authority\"\n}",
